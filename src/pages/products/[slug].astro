---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, pageTitle } from "@/config/site";
import { formatPrice, getProducts, getRelated, type Product } from "@/data/products";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: getRelated(products, product.slug) },
  }));
}

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const cartEnabled = siteConfig.commerce.cartEnabled;

const origin = Astro.site ?? new URL(Astro.url.origin);
const productUrl = new URL(`/products/${product.slug}/`, origin).href;

const specs = [
  ["소재", product.material],
  ["크기", product.dimensions],
  ["마감", product.finish],
  ["준비 기간", product.leadTime],
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: product.images.map((image) => new URL(image.src, origin).href),
  brand: { "@type": "Brand", name: siteConfig.name },
  material: product.material,
  url: productUrl,
  // An Offer is only emitted once there is a way to buy; until then the
  // visible page carries no purchase action and the markup must not either.
  ...(cartEnabled && {
    offers: {
      "@type": "Offer",
      priceCurrency: siteConfig.commerce.currency,
      price: product.price,
      url: productUrl,
    },
  }),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "상품", item: new URL("/catalog/", origin).href },
    { "@type": "ListItem", position: 2, name: product.name, item: productUrl },
  ],
};
---

<BaseLayout
  title={pageTitle(product.name)}
  description={product.description.slice(0, 155)}
  image={product.images[0]}
>
  <main id="main-content" class="shell">
    <nav class="flex gap-2 py-6 text-[0.875rem] text-muted" aria-label="현재 위치">
      <a href="/catalog/" class="link">상품</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink" aria-current="page">{product.name}</span>
    </nav>

    <div class="grid items-start gap-x-12 gap-y-10 border-t border-line pt-8 lg:grid-cols-12">
      {/* ------------------------------------------------------------ Gallery */}
      <section class="lg:col-span-7" aria-label={`${product.name} 이미지`} data-product-gallery>
        <div class="relative overflow-hidden bg-surface">
          {
            product.images.map((image, index) => (
              <div class:list={["gallery-panel", index !== 0 && "is-hidden"]} data-gallery-panel={index}>
                <Image
                  src={image}
                  alt={`${product.name} — ${product.images.length}장 중 ${index + 1}번째 이미지`}
                  width={1440}
                  height={1800}
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding={index === 0 ? "sync" : "async"}
                  class="aspect-[4/5] w-full object-cover"
                />
              </div>
            ))
          }
        </div>

        <div class="mt-3 grid grid-cols-3 gap-3" role="group" aria-label="이미지 선택">
          {
            product.images.map((image, index) => (
              <button
                type="button"
                class="gallery-thumb overflow-hidden bg-surface"
                data-gallery-thumb={index}
                aria-label={`${index + 1}번째 이미지 보기`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <Image
                  src={image}
                  alt=""
                  width={360}
                  height={360}
                  format="webp"
                  loading="lazy"
                  class="aspect-square w-full object-cover"
                />
              </button>
            ))
          }
        </div>
      </section>

      {/* --------------------------------------------------------- Buy column */}
      <div class="lg:sticky lg:top-28 lg:col-span-5">
        <p class="label">{product.collection}</p>
        <h1 class="type-h2 mt-5">{product.name}</h1>
        <p class="mono mt-5 text-xl">{formatPrice(product.price)}</p>

        <p class="type-body mt-8 max-w-[46ch]">{product.description}</p>

        <dl class="mt-10 border-t border-line text-[0.9375rem]">
          {
            specs.map(([term, value]) => (
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="text-muted">{term}</dt>
                <dd class="text-right">{value}</dd>
              </div>
            ))
          }
        </dl>

        {
          cartEnabled ? (
            <div class="mt-10 flex flex-wrap items-stretch gap-3">
              <div class="qty" data-quantity>
                <button type="button" data-quantity-decrease aria-label="수량 줄이기" disabled>
                  −
                </button>
                <output data-quantity-value aria-live="polite" aria-label="수량">
                  1
                </output>
                <button type="button" data-quantity-increase aria-label="수량 늘리기">
                  +
                </button>
              </div>
              <button type="button" class="btn btn-primary flex-1" data-add-to-cart={product.slug} data-add-quantity="1">
                장바구니 담기
              </button>
            </div>
          ) : (
            <p class="type-body mt-10 border-t border-line pt-6 text-[0.9375rem]">
              구매 방법은 준비 중입니다. 판매가 시작되면 이 자리에서 안내해 드립니다.
            </p>
          )
        }
      </div>
    </div>

    {/* ------------------------------------------------------------- Related */}
    {
      related.length > 0 && (
        <section class="mt-32 md:mt-44" aria-labelledby="related-heading">
          <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-t border-line pt-8" data-reveal>
            <h2 id="related-heading" class="type-h2 max-w-[16ch]">
              함께 보면 좋은 물건
            </h2>
            <a href="/catalog/" class="link link-mono pb-1.5 text-muted">
              전체 상품 보기
            </a>
          </div>

          <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
            {related.map((item, index) => (
              <ProductCard product={item} headingLevel="h3" revealDelay={index * 110} />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <style>
    .gallery-panel.is-hidden {
      display: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .gallery-panel:not(.is-hidden) {
        animation: panel-in 600ms var(--ease-out-expo) both;
      }

      @keyframes panel-in {
        from {
          opacity: 0;
          transform: scale(1.015);
        }
      }
    }

    .gallery-thumb {
      box-shadow: inset 0 0 0 1px var(--line);
      transition: box-shadow 260ms ease;
    }

    .gallery-thumb:hover {
      box-shadow: inset 0 0 0 1px var(--line-strong);
    }

    .gallery-thumb[aria-pressed="true"] {
      box-shadow: inset 0 0 0 2px var(--accent);
    }
  </style>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <script is:inline>
    (() => {
      const gallery = document.querySelector("[data-product-gallery]");
      if (gallery) {
        const panels = Array.from(gallery.querySelectorAll("[data-gallery-panel]"));
        const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", () => {
            const active = thumb.dataset.galleryThumb;
            panels.forEach((panel) => panel.classList.toggle("is-hidden", panel.dataset.galleryPanel !== active));
            thumbs.forEach((button) => {
              button.setAttribute("aria-pressed", String(button === thumb));
            });
          });
        });
      }

      // Quantity stepper. The chosen value rides on the add-to-cart button as
      // `data-add-quantity`; the delegated handler in BaseLayout reads it, adds
      // the line and opens the drawer, so there is no add logic on this page.
      const stepper = document.querySelector("[data-quantity]");
      const addButton = document.querySelector("[data-add-to-cart]");
      if (!stepper || !addButton) return;

      const output = stepper.querySelector("[data-quantity-value]");
      const decrease = stepper.querySelector("[data-quantity-decrease]");
      const increase = stepper.querySelector("[data-quantity-increase]");
      const MAX = 99;
      let quantity = 1;

      function setQuantity(next) {
        quantity = Math.min(MAX, Math.max(1, next));
        output.textContent = String(quantity);
        addButton.dataset.addQuantity = String(quantity);
        decrease.disabled = quantity === 1;
        increase.disabled = quantity === MAX;
      }

      decrease.addEventListener("click", () => setQuantity(quantity - 1));
      increase.addEventListener("click", () => setQuantity(quantity + 1));
      document.addEventListener("nooks-cart-change", () => setQuantity(1));
    })();
  </script>
</BaseLayout>
