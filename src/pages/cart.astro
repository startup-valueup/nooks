---
import CartView from "@/components/CartView.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, pageTitle } from "@/config/site";

const cartEnabled = siteConfig.commerce.cartEnabled;
---

<BaseLayout
  title={pageTitle("장바구니")}
  description={`${siteConfig.name} 장바구니`}
  noindex={true}
>
  {
    cartEnabled ? (
      <CartView />
    ) : (
      <main id="main-content" class="shell flex min-h-[60vh] flex-col justify-center py-24">
        <h1 class="type-h1 hero-in max-w-[12ch]">장바구니는 준비 중입니다</h1>
        <p class="type-lead hero-in mt-8 max-w-[34em]" style="--reveal-delay:120ms">
          아직 이 사이트에서는 주문을 받지 않습니다. 구매 방법이 정해지면 상품 페이지에서 안내해 드립니다.
        </p>
        <div class="hero-in mt-10 flex flex-wrap gap-3" style="--reveal-delay:200ms">
          <a href="/catalog/" class="btn btn-primary">
            상품 보기
          </a>
          <a href="/" class="btn btn-outline">
            홈으로
          </a>
        </div>
      </main>
    )
  }
</BaseLayout>
