---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NookArt from "@/components/NookArt.astro";
import { siteConfig, pageTitle } from "@/config/site";

// Brand beliefs, written as intent rather than as claims about origin, process
// or materials — those belong here only once they are real and confirmed.
const principles = [
  {
    heading: "작은 자리에서 시작합니다",
    copy: "집은 큰 공간이기 전에 작은 자리들의 모음입니다. 아침에 손이 닿는 선반, 저녁에 앉는 의자 옆. NOOKS는 그런 자리에 어울리는 물건을 생각합니다.",
  },
  {
    heading: "덜어내고 남깁니다",
    copy: "더하는 것보다 덜어내는 일이 어렵습니다. 꼭 필요한 쓰임과 단정한 형태만 남긴 물건이 오래 곁에 머뭅니다.",
  },
  {
    heading: "천천히, 정직하게",
    copy: "빠르게 소비되는 물건이 아니라 오래 쓰는 물건을 소개합니다. 소개하는 물건에 대해서는 알고 있는 것을 있는 그대로 말씀드립니다.",
  },
];
---

<BaseLayout
  title={pageTitle("브랜드 이야기")}
  description="NOOKS는 집과 일상 곳곳의 작은 자리를 위한 프리미엄 라이프스타일 브랜드입니다. 오래 곁에 두고 싶은 물건에 대한 NOOKS의 생각을 소개합니다."
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[14ch]">작은 자리에도 품격이 머뭅니다</h1>
      <p class="type-lead hero-in mt-8 max-w-[34em]" style="--reveal-delay:120ms">
        NOOKS는 영어 ‘nook’, 아늑하게 머물 수 있는 작은 구석에서 이름을 가져왔습니다. 크지 않아도 마음이 놓이는 자리, 그런 자리를
        위한 물건을 만나는 곳입니다.
      </p>
    </section>

    {/* ------------------------------------------------------------ Meaning */}
    <section class="shell grid gap-10 md:grid-cols-12 md:gap-12" aria-label="NOOKS라는 이름">
      <div class="hero-in md:col-span-6" style="--reveal-delay:200ms">
        <div class="arch-top aspect-[6/7] w-full max-w-[30rem] bg-surface-strong">
          <NookArt />
        </div>
      </div>

      <div class="self-center md:col-span-5 md:col-start-8" data-reveal>
        <p class="type-h3 text-[clamp(1.375rem,2.4vw,2rem)] leading-[1.4]">
          로고의 아치는 벽에 낸 작은 오목한 자리, 니치(niche)를 닮았습니다. 비어 있기에, 무엇을 두어도 그 물건이 주인공이 되는
          자리입니다.
        </p>
        <p class="type-body mt-8 border-t border-line pt-6 text-[0.9375rem]">
          NOOKS는 특정 상품군을 정해 두지 않습니다. 거실에서 책상 위까지, 생활의 여러 자리에 어울리는 물건을 하나씩 더해 갑니다.
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------- Principles */}
    <section class="shell mt-24 md:mt-36" aria-labelledby="principles-heading">
      <div class="rule" data-reveal="line"></div>
      <h2 id="principles-heading" class="type-h2 mt-8 max-w-[16ch]" data-reveal>NOOKS의 생각</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          principles.map((principle, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <p class="mono text-[0.75rem] text-accent">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="type-h3 mt-3">{principle.heading}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{principle.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------------------- CTA */}
    <section id="contact" class="shell mt-24 md:mt-36" aria-labelledby="about-cta-heading">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 id="about-cta-heading" class="type-h2 max-w-[16ch]">
            NOOKS의 물건을 만나보세요
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href="/catalog/" class="btn btn-primary">상품 보기</a>
          {
            siteConfig.email && (
              <a href={`mailto:${siteConfig.email}`} class="btn btn-outline">
                문의하기
              </a>
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
