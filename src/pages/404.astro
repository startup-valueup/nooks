---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageTitle } from "@/config/site";
---

<BaseLayout
  title={pageTitle("페이지를 찾을 수 없습니다")}
  description="요청하신 페이지가 없거나 이동되었습니다."
  noindex={true}
>
  <main id="main-content" class="shell flex min-h-[70vh] flex-col justify-center py-24">
    <p class="mono hero-in text-[0.8125rem] text-accent">404</p>
    <h1 class="type-hero hero-in mt-6 max-w-[14ch]" style="--reveal-delay:90ms">찾으시는 자리가 비어 있습니다</h1>
    <p class="type-lead hero-in mt-8 max-w-[34em]" style="--reveal-delay:180ms">
      요청하신 페이지가 없거나 다른 곳으로 옮겨졌습니다. 주소를 다시 확인하시거나 홈에서 다시 시작해 주세요.
    </p>
    <div class="hero-in mt-10 flex flex-wrap gap-3" style="--reveal-delay:260ms">
      <a href="/" class="btn btn-primary">홈으로</a>
      <a href="/catalog/" class="btn btn-outline">상품 보기</a>
    </div>
  </main>
</BaseLayout>
